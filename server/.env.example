# Copy this to ".env" and fill in your real values — never commit .env

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Gmail address used to SEND the email
# Requires a 16-char App Password (not your normal login):
# https://myaccount.google.com/apppasswords
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# Where contact form submissions are delivered
CONTACT_TO_EMAIL=vorawut.maggy@gmail.com

# Port the Go server listens on (optional, default 8080)
PORT=8080
