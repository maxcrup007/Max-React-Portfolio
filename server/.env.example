# Copy this file to ".env" and fill in your real values.
# Do NOT commit your real ".env" file.

# SMTP server used to send the email (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Gmail address that will send the message (requires a 16-character App Password,
# not your normal login password: https://myaccount.google.com/apppasswords)
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-char-app-password

# Where contact form submissions should be delivered
CONTACT_TO_EMAIL=vorawut.maggy@gmail.com

# Port the Go server listens on (optional, defaults to 8080)
PORT=8080
